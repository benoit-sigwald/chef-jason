# Copie ce fichier en ".env" puis colle ta clé OpenRouter GRATUITE.
# Obtenir une clé gratuite : https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modèles open-source (optionnels — valeurs par défaut gratuites) :
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# Port du serveur local (optionnel)
PORT=3000
